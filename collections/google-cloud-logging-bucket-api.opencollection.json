{
  "opencollection": "1.0.0",
  "info": {
    "name": "Google Cloud Logging Bucket API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
      "accessTokenUrl": "https://oauth2.googleapis.com/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Bucket",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get bucket",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://logging.googleapis.com/v2/:name/bucket",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get bucket"
        },
        {
          "info": {
            "name": "Update bucket",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://logging.googleapis.com/v2/:name/bucket",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              },
              {
                "name": "updateMask",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update bucket"
        },
        {
          "info": {
            "name": "Delete bucket",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://logging.googleapis.com/v2/:name/bucket",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete bucket"
        }
      ]
    }
  ],
  "bundled": true
}